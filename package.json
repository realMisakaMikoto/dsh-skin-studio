{
  "name": "@local/dsh-desktop-skin-studio",
  "version": "0.7.0",
  "private": true,
  "description": "Desktop-adapted skin studio for DeepSeek Harness: full-interface palettes, wallpaper, per-component media, visual assets, copy and free-text overrides, with .dshskin v5 import/export.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_ASSETS.md",
    "docs",
    "src",
    "types",
    "tsdown.config.ts",
    "tsconfig.json",
    "scripts",
    "LICENSE.local-MIT",
    "tests",
    "install-desktop.cmd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node --check client.js && node scripts/validate-package.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm test",
    "asar": "node scripts/extract-asar.mjs",
    "drift": "node scripts/check-against-dsh.mjs",
    "check:install": "node scripts/check-install.mjs",
    "verify:client": "node scripts/verify-client-boot.mjs",
    "host:verify": "node scripts/verify-against-host.mjs",
    "host:routes": "node scripts/inspect-plugins-route.mjs",
    "install:desktop": "node scripts/install-desktop.mjs",
    "release:pack": "node scripts/pack-public-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.0",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "fake-indexeddb": "6.2.2",
    "jsdom": "27.0.0",
    "lightningcss": "1.29.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realMisakaMikoto/dsh-skin-studio.git"
  },
  "homepage": "https://github.com/realMisakaMikoto/dsh-skin-studio#readme",
  "bugs": {
    "url": "https://github.com/realMisakaMikoto/dsh-skin-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "desktop",
    "skin",
    "theme",
    "nijigasaki"
  ]
}
